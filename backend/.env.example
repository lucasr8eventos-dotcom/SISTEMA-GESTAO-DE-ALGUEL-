PORT=5000

# Railway fornece DATABASE_URL automaticamente ao provisionar PostgreSQL.
# Se DATABASE_URL estiver definido, as variáveis DB_* abaixo são ignoradas.
DATABASE_URL=

# Credenciais locais (usadas apenas sem DATABASE_URL)
DB_USER=postgres
DB_HOST=localhost
DB_NAME=gestao_alugueis
DB_PASSWORD=postgres
DB_PORT=5432

JWT_SECRET=MUDE_ISSO_EM_PRODUCAO_use_uma_string_longa_e_aleatoria_minimo_32_chars
JWT_EXPIRES_IN=8h
NODE_ENV=production
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Admin inicial (criado no boot apenas se não houver nenhum admin no banco).
# Defina ADMIN_PASSWORD com uma senha forte. Se deixar em branco, o servidor
# gera uma senha aleatória e a exibe UMA vez no log do primeiro boot.
ADMIN_EMAIL=admin@sistema.com
ADMIN_PASSWORD=

# URL pública do frontend no Railway (ex: https://meu-frontend.up.railway.app)
FRONTEND_URL=http://localhost:3000
