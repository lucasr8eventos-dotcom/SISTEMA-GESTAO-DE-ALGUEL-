PORT=5000

# Railway fornece DATABASE_URL automaticamente ao provisionar PostgreSQL.
# Se DATABASE_URL estiver definido, as variáveis DB_* abaixo são ignoradas.
DATABASE_URL=

# Tamanho máximo do pool de conexões (default 10).
# Railway Hobby Postgres tem limite baixo — não suba acima de 15.
DB_POOL_MAX=10

# Credenciais locais (usadas apenas sem DATABASE_URL)
DB_USER=postgres
DB_HOST=localhost
DB_NAME=gestao_alugueis
DB_PASSWORD=postgres
DB_PORT=5432

# JWT — OBRIGATÓRIO em produção. Mínimo 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=MUDE_ISSO_EM_PRODUCAO_use_uma_string_longa_e_aleatoria_minimo_32_chars
JWT_EXPIRES_IN=8h

NODE_ENV=production

# Diretório de uploads. No Railway, MONTE UM VOLUME nesse caminho
# (Settings > Volumes > Mount path: /app/uploads), senão os PDFs serão
# perdidos a cada deploy.
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# URL(s) do frontend autorizadas (CORS). Separe por vírgula se houver múltiplas.
# Ex: https://app.up.railway.app,https://www.meusite.com
FRONTEND_URL=http://localhost:3000
