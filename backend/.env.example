PORT=5000

# Railway fornece DATABASE_URL automaticamente ao provisionar PostgreSQL.
# Se DATABASE_URL estiver definido, as variáveis DB_* abaixo são ignoradas.
DATABASE_URL=

# Credenciais locais (usadas apenas sem DATABASE_URL)
DB_USER=postgres
DB_HOST=localhost
DB_NAME=gestao_alugueis
DB_PASSWORD=postgres
DB_PORT=5432

# OBRIGATÓRIO: gere um valor forte, único e SECRETO antes de subir em produção.
# Rode:  openssl rand -hex 32   (ou: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# Deixe VAZIO aqui e defina no ambiente (Railway > Variables). Em produção, se ficar
# vazio/curto o servidor NÃO sobe (proteção). NUNCA reutilize o exemplo de outro projeto.
JWT_SECRET=
JWT_EXPIRES_IN=8h
NODE_ENV=production

# ⚠️ IMPORTANTE — PERSISTÊNCIA DOS ANEXOS (PDFs de contrato):
# O disco do container do backend é EFÊMERO no Railway — tudo que estiver em
# pasta comum é APAGADO a cada redeploy/restart. Para NÃO perder os PDFs de
# contrato anexados, crie um VOLUME no serviço do backend (ex.: montado em
# /data) e aponte o UPLOAD_DIR para dentro dele. Sem volume, os arquivos somem
# no próximo deploy (o cadastro continua, mas o "Ver PDF" deixa de achar o arquivo).
# Os DADOS do sistema (imóveis, contratos, pagamentos...) ficam no PostgreSQL,
# que JÁ tem volume — esses não se perdem.
UPLOAD_DIR=/data/uploads
MAX_FILE_SIZE_MB=10

# Carrega dados FICTÍCIOS de demonstração no boot (NUNCA usar em produção).
# Deixe vazio/false em produção — o sistema sobe limpo.
SEED_EXAMPLE_DATA=false

# Admin inicial (criado no boot apenas se não houver nenhum admin no banco).
# Defina ADMIN_PASSWORD com uma senha forte. Se deixar em branco, o servidor
# gera uma senha aleatória e a exibe UMA vez no log do primeiro boot.
ADMIN_EMAIL=admin@sistema.com
ADMIN_PASSWORD=

# URL pública do frontend no Railway (ex: https://meu-frontend.up.railway.app)
FRONTEND_URL=http://localhost:3000
